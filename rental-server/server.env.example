# Hosting Service local configuration
# Copy this file to server.env. Do not commit server.env.

# ------------------------------------------------------------
# Core mode
# ------------------------------------------------------------
# Local Docker runner: runner
# Render deployment: render
BACKEND_PROVIDER=runner

# ------------------------------------------------------------
# Web control service / customer accounts
# ------------------------------------------------------------
APP_HOST=0.0.0.0
PORT=8080
CREATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO
LEASE_DAYS=30

# Flask customer login session secret.
SESSION_SECRET=CHANGE_ME_GENERATED

# Secret used to derive/validate per-server provider management keys.
INSTANCE_KEY_SECRET=CHANGE_ME_GENERATED

# Admin accounts, comma-separated. Keep the real list out of public repos.
ADMIN_EMAILS=admin@example.com

# Preferred production data store. When REDIS_URL is set, accounts and
# hosting metadata use Redis/Render Key Value instead of SQLite/Postgres.
REDIS_URL=

# Optional SQL fallback. Local development can use SQLite.
DATABASE_URL=sqlite:///data/rental.db
DATABASE_PATH=data/rental.db

# Base domain for shared-hosting subdomains.
# Example: HOSTING_BASE_DOMAIN=hosting.example.com
# Then services are issued as: <resource>.hosting.example.com
HOSTING_BASE_DOMAIN=

# ------------------------------------------------------------
# Local Docker Runner
# ------------------------------------------------------------
RUNNER_HOST=127.0.0.1
RUNNER_PORT=9000
RUNNER_URL=http://127.0.0.1:9000
RUNNER_TOKEN=CHANGE_ME_GENERATED
MAX_INSTANCES=10

# Base URL placed in each Runner instance's Public URL.
# Local Windows/Docker Desktop usually works with http://127.0.0.1.
# On a remote host set this to the hostname/IP that reaches Docker-published ports.
RUNNER_PUBLIC_BASE_URL=http://127.0.0.1

# ------------------------------------------------------------
# Render provider
# Keep RENDER_API_KEY secret. Never commit a real key.
# ------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_TENANT_REPO=https://github.com/ritsu1000000-maker/sandbox
RENDER_TENANT_BRANCH=rental-server-mvp
RENDER_TENANT_REGION=singapore
RENDER_SERVICE_PREFIX=rental
ALLOW_PAID_RENDER_PLANS=false

# Provider HTTP timeout
REQUEST_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# Production Gunicorn
# ------------------------------------------------------------
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_CMD_ARGS=--config gunicorn.conf.py
